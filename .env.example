# Required
DISCORD_TOKEN=

# Optional. If omitted, the bot uses its application ID after logging in.
DISCORD_CLIENT_ID=

# Optional. If set, slash commands are registered instantly in this guild.
# If omitted, commands are registered globally and may take time to appear.
DISCORD_GUILD_ID=

# AniList
ANILIST_URL=https://graphql.anilist.co
REQUEST_TIMEOUT=10000
CHECK_INTERVAL=60
FAILURE_THRESHOLD=2
RECOVERY_THRESHOLD=2

# Optional initial alert destination. You can also use /set-channel.
DISCORD_CHANNEL_ID=
# Optional channel for a new AniList status embed after every check
DISCORD_STATUS_CHANNEL_ID=
DISCORD_ROLE_ID=

# Optional initial message defaults. Persistent settings can later be changed with commands.
ALERT_MESSAGE=AniList API is currently unavailable. We cannot do anything about the upstream outage, and apps using AniList may not work properly.\n\nStatus: {status}\nHTTP: {http_status}\nResponse time: {response_time}\nDetails: {error}\nDetected: {timestamp}\n{retry_after}
RECOVERY_MESSAGE=AniList API has recovered and is responding normally again.\n\nStatus: {status}\nResponse time: {response_time}\nDowntime: {downtime}\nRecovered: {timestamp}

# Logging: error | warn | info | debug
LOG_LEVEL=info

# Optional storage location. Defaults to ./data/state.json
STATE_FILE=./data/state.json

# Maximum retained health-check records.
HISTORY_LIMIT=500

# Rate-limit backoff settings. Values are seconds.
RATE_LIMIT_BACKOFF=120
MAX_RATE_LIMIT_BACKOFF=600
