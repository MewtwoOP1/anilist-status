{
  "name": "anilist-discord-monitor",
  "version": "1.0.0",
  "description": "Production-ready Discord bot for monitoring the AniList GraphQL API.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node src/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
